# DDP-Sync local development config
# Copy to .env and fill in values. Production uses AWS Secrets Manager.

DDP_SYNC_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=votebot-large
PINECONE_NAMESPACE=default
# SYNC-89: index for the new embedding path (PLAN-enterprise-search.md §5.6). Empty = disabled.
# Must differ from PINECONE_INDEX_NAME; the legacy path never reads this.
KNOWLEDGE_BASE_INDEX_NAME=
# SYNC-157: there is no public OpenStates API setting (OPENSTATES_API_KEY, OPENSTATES_API_BASE) and no routing
# list (DDP_OPENSTATES_JURISDICTIONS): every OpenStates read goes to this host's own api-v3 (LOCAL_OPENSTATES_API_*
# on the Mac, RDS_OPENSTATES_API_* on EC2), and which states we serve is ddp-open-states' jurisdictions.yaml.
CONGRESS_API_KEY=
REDIS_URL=redis://localhost:6379/0
WEBFLOW_SCHEDULER_API_KEY=
WEBFLOW_API_TOKEN=
WEBFLOW_ASSETS_READ_WRITE_KEY=
WEBFLOW_SITE_ID=
WEBFLOW_BILLS_COLLECTION_ID=
WEBFLOW_JURISDICTION_COLLECTION_ID=
WEBFLOW_LEGISLATORS_COLLECTION_ID=
WEBFLOW_CATEGORIES_COLLECTION_ID=
WEBFLOW_ORGANIZATIONS_COLLECTION_ID=
BREVO_API_KEY=
BREVO_RATE_LIMIT_RPH=36000
ZAPIER_WEBHOOK_URL=
SYNC_INTERVAL_MINUTES=30

# Slack alerts (slack_alerts.post_alert, SYNC-99). Every alert posts to HEALTH_ALERT_SLACK_CHANNEL
# with SLACK_BOT_TOKEN (the Agent Smith app's token; needs chat:write and chat:write.customize) as
# CodeBot. An empty CODEBOT_* value means the default (CodeBot, :robot_face:). On the Mac,
# scripts/start-ddp-sync.sh copies SLACK_BOT_TOKEN and the CODEBOT_* pair from ddp-agents/.env when
# they are not set here; on EC2, infrastructure/render-env.sh writes them from Secrets Manager
# (keys slack_bot_token, codebot_slack_username, codebot_slack_icon_emoji).
SLACK_BOT_TOKEN=
HEALTH_ALERT_SLACK_CHANNEL=#automation-errors
CODEBOT_SLACK_USERNAME=CodeBot
CODEBOT_SLACK_ICON_EMOJI=:codebot:
# SYNC-132: send alerts to CAMS's operator-alert route first (it queues, retries, de-duplicates and shows a refused
# alert in `cams status`); any failure falls back to the direct post above. Unset OPERATOR_ALERT_URL = direct only.
# Mac: http://localhost:8000/api/v1/operator-alerts, and CAMS_API_TOKEN (already set) is used as the token.
# EC2: the URL is set in docker-compose.prod.yml and render-env.sh writes OPERATOR_ALERT_TOKEN from the secret's
# `operator_alert_token` key. Do NOT put the token in the secret as `cams_api_token` (see render-env.sh).
# OPERATOR_ALERT_VIA_CAMS=false turns the route off on a hand-edited .env (the Mac, dev); on EC2 delete the compose
# line instead (render-env.sh rewrites .env). Via the route the channel comes from CAMS's map.
OPERATOR_ALERT_URL=
OPERATOR_ALERT_TOKEN=

# API health check (scripts/check_api_health.py)
DDP_API_BASE_URL=https://api.digitaldemocracyproject.org
DDP_API_KEY=

# This host's own api-v3 (ddp-open-states). Since SYNC-157 every OpenStates read on the Mac goes here (EC2 uses
# RDS_OPENSTATES_API_BASE/_KEY). Local dev stack's seeded Profile key is the
# well-known 00000000-0000-0000-0000-000000000001 sentinel.
LOCAL_OPENSTATES_API_BASE=http://localhost:8002
LOCAL_OPENSTATES_API_KEY=

# CAMS (LegBot's inference service) -- previously undocumented here, so this
# machine ran on defaults for weeks without anyone realizing they were
# settable. cams_base_url/cams_api_token/cams_artifacts_dir and both timeouts
# below are real config.py fields, not placeholders.
CAMS_BASE_URL=http://localhost:8000
CAMS_API_TOKEN=
# Where CAMS writes each completed task's task_result.json -- must point at
# the same directory CAMS itself writes to (its own CAMS_ARTIFACTS_DIR), not
# a copy, since ddp-sync reads the file directly off disk rather than over
# the API.
CAMS_ARTIFACTS_DIR=
# How long _dispatch_and_await polls a LegBot task before giving up, measured
# from when MLX generation actually starts (see AGENTS-42/config.py's own
# comment for the two-phase queue-wait/inference-timeout split). Default is
# 1200 (20 min) if unset -- generous by design (local MLX compute has no
# per-call cost), but found live 2026-09-12 to still be too short for some
# large/complex bills. Raising this does NOT help every slow bill: a bill
# whose diff is dominated by document-reformatting noise (see OPEN-282) can
# run past any reasonable timeout without ever producing a useful answer --
# check whether that's the actual cause before just raising this further.
LEGBOT_DISPATCH_TIMEOUT_SECONDS=1200
