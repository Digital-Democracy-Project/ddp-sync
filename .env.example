# DDP-Sync local development config
# Copy to .env and fill in values. Production uses AWS Secrets Manager.

DDP_SYNC_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=votebot-large
PINECONE_NAMESPACE=default
OPENSTATES_API_KEY=
# Public v3.openstates.org API base -- override only for tests/alternate hosts.
OPENSTATES_API_BASE=https://v3.openstates.org
# Jurisdictions (comma-separated, e.g. "MI,UT,US,VA") to route through the
# RDS-backed OpenStates replica (RDS_OPENSTATES_API_BASE/RDS_OPENSTATES_API_KEY
# below) instead of the public API. Empty/unset = always public API (today's
# behavior).
# Production (Secrets Manager JSON): keys are `openstates_api_base` (string) and
# `ddp_openstates_jurisdictions` (list of strings), not the env var names above.
DDP_OPENSTATES_JURISDICTIONS=
# RDS-backed OpenStates-compatible API (api-v3) used for the jurisdictions
# listed above -- distinct from OPENSTATES_API_KEY (the public
# v3.openstates.org API) and from the Mac Studio's own separate local
# Postgres instance. No portable default across environments.
RDS_OPENSTATES_API_BASE=
RDS_OPENSTATES_API_KEY=
CONGRESS_API_KEY=
REDIS_URL=redis://localhost:6379/0
WEBFLOW_SCHEDULER_API_KEY=
WEBFLOW_API_TOKEN=
WEBFLOW_ASSETS_READ_WRITE_KEY=
WEBFLOW_SITE_ID=
WEBFLOW_BILLS_COLLECTION_ID=
WEBFLOW_JURISDICTION_COLLECTION_ID=
WEBFLOW_LEGISLATORS_COLLECTION_ID=
WEBFLOW_CATEGORIES_COLLECTION_ID=
WEBFLOW_ORGANIZATIONS_COLLECTION_ID=
BREVO_API_KEY=
BREVO_RATE_LIMIT_RPH=36000
ZAPIER_WEBHOOK_URL=
SYNC_INTERVAL_MINUTES=30

# API health check (scripts/check_api_health.py)
DDP_API_BASE_URL=https://api.digitaldemocracyproject.org
DDP_API_KEY=
